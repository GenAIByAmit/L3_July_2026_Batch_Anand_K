"""
Multi-Query RAG Example using LangChain
---------------------------------------
This script:
1. Loads documents into a vector store.
2. Uses MultiQueryRetriever to generate multiple query variations.
3. Retrieves relevant chunks.
4. Passes them to an LLM for an answer.
"""

import os
from langchain_openai import ChatOpenAI, OpenAIEmbeddings
from langchain_community.vectorstores import FAISS
from langchain_community.document_loaders import TextLoader
from langchain.text_splitter import RecursiveCharacterTextSplitter
from langchain.retrievers.multi_query import MultiQueryRetriever

# -----------------------------
# 1. Setup API Key (Environment Variable)
# -----------------------------
# Make sure you have set your OpenAI API key:
# export OPENAI_API_KEY="your_api_key_here"
if not os.getenv("OPENAI_API_KEY"):
    raise EnvironmentError("Please set the OPENAI_API_KEY environment variable.")

# -----------------------------
# 2. Load and Prepare Documents
# -----------------------------
# Example: Load a local text file (replace with your own data)
loader = TextLoader("sample_docs.txt", encoding="utf-8")
documents = loader.load()

# Split into smaller chunks for better retrieval
splitter = RecursiveCharacterTextSplitter(chunk_size=500, chunk_overlap=50)
docs = splitter.split_documents(documents)

# -----------------------------
# 3. Create Vector Store
# -----------------------------
embeddings = OpenAIEmbeddings()
vectorstore = FAISS.from_documents(docs, embeddings)

# -----------------------------
# 4. Initialize LLM
# -----------------------------
llm = ChatOpenAI(model="gpt-3.5-turbo", temperature=0)

# -----------------------------
# 5. Multi-Query Retriever
# -----------------------------
retriever = MultiQueryRetriever.from_llm(
    retriever=vectorstore.as_retriever(),
    llm=llm
)

# -----------------------------
# 6. Ask a Question
# -----------------------------
query = "What are the main benefits of using solar energy?"
retrieved_docs = retriever.get_relevant_documents(query)

print("\n--- Retrieved Documents ---")
for i, doc in enumerate(retrieved_docs, start=1):
    print(f"[Doc {i}] {doc.page_content[:200]}...\n")

# -----------------------------
# 7. Generate Final Answer
# -----------------------------
from langchain.chains import RetrievalQA

qa_chain = RetrievalQA.from_chain_type(
    llm=llm,
    retriever=retriever,
    chain_type="stuff"
)

answer = qa_chain.run(query)
print("\n--- Final Answer ---")
print(answer)